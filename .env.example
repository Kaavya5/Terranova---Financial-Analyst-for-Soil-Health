# ─── DATABASE ──────────────────────────────────────────────────────────────────
# SQLite (local dev - zero setup needed):
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# PostgreSQL (production on Render / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── AUTH ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI / GROQ ────────────────────────────────────────────────────────────────
# Get your FREE key at https://console.groq.com
NEXT_PUBLIC_GROQ_API_KEY=gsk_...

# ─── ML SERVICE ───────────────────────────────────────────────────────────────
# Local dev:
ML_SERVICE_URL=http://localhost:8001
# Production (Render URL of your ml_service after deploying):
# ML_SERVICE_URL=https://terranova-ml.onrender.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Production (your Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,https://localhost:3000

# ─── FRONTEND (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production:
# NEXT_PUBLIC_API_URL=https://terranova-backend.onrender.com

# ─── FRONTEND .env.local (create this file inside the frontend/ folder) ────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_GROQ_API_KEY=gsk_...
